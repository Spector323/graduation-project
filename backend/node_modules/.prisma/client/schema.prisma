generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Establishment {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("RESTAURANT")
  address   String   @default("")
  phone     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          User[]
  tables         RestaurantTable[]
  categories     MenuCategory[]
  reservations   Reservation[]
  shifts         Shift[]
  ingredients    Ingredient[]
  modifierGroups ModifierGroup[]

  @@map("establishments")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  fullName  String   @map("full_name")
  role      String   @default("WAITER")
  pinCode   String?  @map("pin_code")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  establishmentId String?        @map("establishment_id")
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])

  orders       Order[]
  reservation  Reservation[]
  openedShifts Shift[]       @relation("ShiftOpener")
  closedShifts Shift[]       @relation("ShiftCloser")

  @@unique([establishmentId, pinCode])
  @@map("users")
}

model RestaurantTable {
  id        String   @id @default(cuid())
  number    Int
  capacity  Int      @default(4)
  status    String   @default("FREE")
  location  String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  establishmentId String        @map("establishment_id")
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  orders       Order[]
  reservations Reservation[]

  @@unique([number, establishmentId])
  @@map("restaurant_tables")
}

model MenuCategory {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  establishmentId String        @map("establishment_id")
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  menuItems MenuItem[]

  @@unique([name, establishmentId])
  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  price       Float    @default(0)
  imageUrl    String   @default("") @map("image_url")
  available   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  categoryId String?       @map("category_id")
  category   MenuCategory? @relation(fields: [categoryId], references: [id])

  orderItems     OrderItem[]
  recipe         RecipeItem[]
  modifierGroups ModifierGroup[]

  @@map("menu_items")
}

// === Р РЋР С™Р вЂєР С’Р вЂќ Р В Р ВР СњР вЂњР В Р вЂўР вЂќР ВР вЂўР СњР СћР В« ===

model Ingredient {
  id          String   @id @default(cuid())
  name        String
  unit        String   @default("g")
  costPerUnit Float    @default(0)
  stock       Float    @default(0)
  minStock    Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  establishmentId String        @map("establishment_id")
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  recipeItems RecipeItem[]

  @@unique([name, establishmentId])
  @@map("ingredients")
}

model RecipeItem {
  id         String   @id @default(cuid())
  menuItemId String   @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  ingredientId String     @map("ingredient_id")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  quantity  Float
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([menuItemId, ingredientId])
  @@map("recipe_items")
}

// === MODIFIER GROUPS ===

model ModifierGroup {
  id        String   @id @default(cuid())
  name      String
  minSelect Int      @default(0)
  maxSelect Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  establishmentId String        @map("establishment_id")
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  modifiers Modifier[]
  menuItems MenuItem[]

  @@map("modifier_groups")
}

model Modifier {
  id    String @id @default(cuid())
  name  String
  price Float  @default(0)

  groupId String        @map("group_id")
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("modifiers")
}

// === ORDER ===

model Order {
  id          String   @id @default(cuid())
  status      String   @default("NEW")
  notes       String   @default("")
  total       Float    @default(0)
  paymentType String?  @map("payment_type")
  paid        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tableId String?          @map("table_id")
  table   RestaurantTable? @relation(fields: [tableId], references: [id])

  waiterId String? @map("waiter_id")
  waiter   User?   @relation(fields: [waiterId], references: [id])

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  unitPrice Float    @default(0) @map("unit_price")
  notes     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String   @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  selectedModifiers Json? @default("[]") @map("selected_modifiers")

  @@map("order_items")
}

model Reservation {
  id            String   @id @default(cuid())
  customerName  String   @map("customer_name")
  customerPhone String   @default("") @map("customer_phone")
  reservedAt    DateTime @map("reserved_at")
  partySize     Int      @default(2) @map("party_size")
  notes         String   @default("")
  status        String   @default("PENDING")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  establishmentId String        @map("establishment_id")
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  tableId String?          @map("table_id")
  table   RestaurantTable? @relation(fields: [tableId], references: [id])

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  @@map("reservations")
}

model AuditLog {
  id              String   @id @default(cuid())
  action          String
  entity          String
  entityId        String?
  details         String   @default("{}")
  userId          String?
  userEmail       String?
  userName        String?
  establishmentId String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([establishmentId, createdAt])
  @@index([action, entity])
  @@map("audit_logs")
}

model Shift {
  id         String    @id @default(cuid())
  openedAt   DateTime  @default(now()) @map("opened_at")
  closedAt   DateTime? @map("closed_at")
  openedById String    @map("opened_by_id")
  closedById String?   @map("closed_by_id")
  cashStart  Float     @default(0) @map("cash_start")
  cashEnd    Float?    @map("cash_end")
  status     String    @default("OPEN")
  createdAt  DateTime  @default(now()) @map("created_at")

  openedBy        User          @relation("ShiftOpener", fields: [openedById], references: [id])
  closedBy        User?         @relation("ShiftCloser", fields: [closedById], references: [id])
  establishmentId String        @map("establishment_id")
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  @@map("shifts")
}
