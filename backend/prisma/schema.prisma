// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles
enum Role {
  ADMIN
  MANAGER
  WAITER
  COOK
}

// Table statuses
enum TableStatus {
  FREE
  RESERVED
  OCCUPIED
}

// Order statuses
enum OrderStatus {
  NEW
  COOKING
  READY
  COMPLETED
  CANCELLED
}

// Reservation statuses
enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// Payment types
enum PaymentType {
  CASH
  CARD
  QR
}

// User model with authentication
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String   @map("full_name")
  role      Role     @default(WAITER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  orders    Order[]
  reservation Reservation[]

  @@map("users")
}

// Restaurant tables
model RestaurantTable {
  id        String      @id @default(uuid())
  number    Int         @unique
  capacity  Int         @default(4)
  status    TableStatus @default(FREE)
  location  String      @default("")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  
  orders       Order[]
  reservations Reservation[]

  @@map("restaurant_tables")
}

// Menu categories
model MenuCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  
  menuItems MenuItem[]

  @@map("menu_categories")
}

// Menu items
model MenuItem {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  price       Float    @default(0)
  imageUrl    String   @map("image_url") @default("")
  available   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  categoryId String? @map("category_id")
  category   MenuCategory? @relation(fields: [categoryId], references: [id])
  
  orderItems OrderItem[]

  @@map("menu_items")
}

// Customer orders
model Order {
  id        String      @id @default(uuid())
  status    OrderStatus @default(NEW)
  notes     String      @default("")
  total     Float       @default(0)
  paymentType PaymentType? @map("payment_type")
  paid      Boolean     @default(false)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  
  tableId     String? @map("table_id")
  table       RestaurantTable? @relation(fields: [tableId], references: [id])
  
  waiterId    String? @map("waiter_id")
  waiter      User?    @relation(fields: [waiterId], references: [id])
  
  items       OrderItem[]

  @@map("orders")
}

// Order items
model OrderItem {
  id        String   @id @default(uuid())
  quantity  Int      @default(1)
  unitPrice Float    @map("unit_price") @default(0)
  notes     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  
  orderId    String  @map("order_id")
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  menuItemId String @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("order_items")
}

// Table reservations
model Reservation {
  id        String           @id @default(uuid())
  customerName    String       @map("customer_name")
  customerPhone   String       @map("customer_phone") @default("")
  reservedAt      DateTime     @map("reserved_at")
  partySize       Int          @map("party_size") @default(2)
  notes           String       @default("")
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  
  tableId String? @map("table_id")
  table   RestaurantTable? @relation(fields: [tableId], references: [id])
  
  userId String? @map("user_id")
  user   User?    @relation(fields: [userId], references: [id])

  @@map("reservations")
}
